{
  "name": "dsh-meme",
  "version": "0.3.0",
  "description": "B站梗百科 deepseek-harness 插件——LLM 操作员驱动的梗采集、归纳、检索与生命周期管理",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cli": {
      "default": "./lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "meme": "lib/cli.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.0 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.0 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@node-rs/jieba": "^2.0.4",
    "fastembed": "^3.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "bilibili",
    "meme",
    "deepseek-harness",
    "dsh"
  ]
}
